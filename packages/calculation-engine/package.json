{
  "name": "@wageguard/calculation-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic, explainable payroll calculation and payslip reconciliation. Pure TypeScript; no I/O.",
  "type": "module",
  "exports": {
    ".": {
      "@wageguard/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:evidence": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=../../benchmarks/test-reports/calculation-engine.json"
  },
  "dependencies": {
    "@wageguard/award-rules": "workspace:*",
    "@wageguard/domain": "workspace:*",
    "zod": "4.6.7"
  }
}
