{
  "name": "@wageguard/award-rules",
  "version": "0.1.0",
  "private": true,
  "description": "Immutable, versioned, source-referenced award rule sets and their schema.",
  "type": "module",
  "exports": {
    ".": {
      "@wageguard/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:evidence": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=../../benchmarks/test-reports/award-rules.json",
    "fingerprint": "tsx --conditions=@wageguard/source scripts/print-fingerprints.ts"
  },
  "dependencies": {
    "@wageguard/domain": "workspace:*",
    "zod": "4.6.7"
  }
}
