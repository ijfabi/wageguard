{
  "name": "@wageguard/api",
  "version": "0.1.0",
  "private": true,
  "description": "WageGuard REST API (NestJS modular monolith adapters around the pure calculation packages).",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "node --conditions=@wageguard/source --import tsx --watch src/main.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:evidence": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=../../benchmarks/test-reports/api.json",
    "seed:demo": "node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@wageguard/api-contracts": "workspace:*",
    "@wageguard/award-rules": "workspace:*",
    "@wageguard/calculation-engine": "workspace:*",
    "@wageguard/domain": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1"
  }
}
