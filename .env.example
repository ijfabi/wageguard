# Copy to .env for local development. Never commit .env.
# Values below are placeholders for a local machine only.

NODE_ENV=development

# PostgreSQL (docker-compose.yml)
POSTGRES_PASSWORD=wageguard-local-only
DATABASE_URL=postgresql://wageguard:wageguard-local-only@127.0.0.1:5432/wageguard

# Email. Outside production, messages are written to .mail-outbox/ instead of being sent.
# To send through Mailpit (docker-compose.yml) instead:
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=WageGuard <no-reply@wageguard.localhost>
APP_BASE_URL=http://localhost:3000

# Two-step sign-in is off without a key. Generate one with: openssl rand -base64 32
# TOTP_ENCRYPTION_KEY=

# Redis (docker-compose.yml)
REDIS_URL=redis://127.0.0.1:6379

# Benchmarks: free-text label recorded with every benchmark run
BENCHMARK_ENVIRONMENT=local-developer-workstation
